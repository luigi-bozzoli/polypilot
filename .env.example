# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development                        # development | production
POLYPILOT_LIVE_MODE=false                  # true enables real order placement

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=polypilot
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_AI_SIGNALS=ai.signals

# ── Orchestrator (Spring Boot) ─────────────────────────────────────────────────
ORCHESTRATOR_PORT=8080
ORCHESTRATOR_API_KEY=                      # protects dashboard REST endpoints

# ── Auth service ───────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_API_KEY=                      # internal secret shared with orchestrator

# Polymarket wallet — never commit real values
POLYMARKET_WALLET_PRIVATE_KEY=             # EIP-712 L1 signing key (hex, 0x-prefixed)
POLYMARKET_API_KEY=                        # L2 CLOB API key
POLYMARKET_API_SECRET=                     # L2 CLOB API secret
POLYMARKET_API_PASSPHRASE=                 # L2 CLOB passphrase

# ── AI agent (LangGraph) ───────────────────────────────────────────────────────
AI_AGENT_URL=http://ai-agent:8002
AI_AGENT_PORT=8002
AI_AGENT_API_KEY=                          # internal secret shared with orchestrator

# LLM provider — set the one you use, leave the other blank
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic                     # anthropic | openai
LLM_MODEL=claude-sonnet-4-20250514         # or gpt-4o

# News API (used by AI agent to fetch articles)
NEWS_API_KEY=                              # https://newsapi.org
NEWS_API_MAX_ARTICLES=5                    # articles fetched per market analysis

# ── Polymarket API endpoints ───────────────────────────────────────────────────
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── Trading engine defaults ────────────────────────────────────────────────────
TRADING_MAX_BET_SIZE_USDC=10               # max single order size in USDC
TRADING_MAX_DAILY_EXPOSURE_USDC=50         # cumulative daily limit in USDC
TRADING_STOP_LOSS_PCT=0.20                 # close position at 20% loss
TRADING_SCHEDULER_CRON=0 */5 * * * *      # run strategies every 5 minutes

# ── Alerting ───────────────────────────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=                         # e.g. Slack incoming webhook URL

# ── Dashboard (Vite / React) ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_API_KEY=                              # same as ORCHESTRATOR_API_KEY
