# ── App ────────────────────────────────────────────────────────────────────────
POLYPILOT_LIVE_MODE=false                  # true enables real order placement
ENCRYPTION_KEY=                            # AES-256 key for wallet_credentials at rest, 32 bytes base64: openssl rand -base64 32

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=polypilot
DB_USER=
DB_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE_AI_SIGNALS=ai.signals

# ── Orchestrator (Spring Boot) ─────────────────────────────────────────────────
JWT_SECRET=                                # HMAC key for signing JWTs (base64, >= 32 bytes). generate with: openssl rand -base64 32
SIWE_DOMAIN=localhost:5173                 # EIP-4361 `domain` the orchestrator accepts
SIWE_URI=http://localhost:5173            # EIP-4361 `uri` the orchestrator accepts
SIWE_ALLOWED_CHAIN_IDS=1,137              # comma-separated chain IDs a SIWE message may declare

# ── Auth service ───────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001

# Polymarket wallet — never commit real values. Deprecated/frozen (see repo CLAUDE.md):
# nothing reads this today except the frozen ClobAuth relay path.
POLYMARKET_PRIVATE_KEY=                    # EIP-712 L1 signing key (hex, 0x-prefixed)

# ── AI agent ─────────────────────────────────────────────────────────────────────
AI_AGENT_URL=http://ai-agent:8002
ANTHROPIC_API_KEY=
# Overrides the sentiment-analysis model (default: claude-haiku-4-5-20251001).
# Check for retired models before changing this: https://platform.claude.com/docs/en/about-claude/model-deprecations
AI_AGENT_MODEL=

# ── Polymarket API endpoints ───────────────────────────────────────────────────
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# ── Binance OHLC ingestion (ohlc-sync job) ─────────────────────────────────────
# All optional — the orchestrator defaults match these values. Symbols and
# timeframes are NOT configured here — they live in the DB ticker / timeframe
# tables (seeded with BTC/ETH and the 15 standard intervals).
BINANCE_BASE_URL=https://api.binance.com
# BINANCE_BACKFILL_CANDLES=1000
# BINANCE_MAX_RETRIES=3
# BINANCE_RETRY_BACKOFF=1s

# ── Dashboard (Vite / React) ───────────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=             # optional — only needed for the WalletConnect (mobile wallet) SIWE path
